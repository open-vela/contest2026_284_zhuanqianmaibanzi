diff --git a/drivers/video/v4l2_cap.c b/drivers/video/v4l2_cap.c
index 731b046729..10f836bd3b 100644
--- a/drivers/video/v4l2_cap.c
+++ b/drivers/video/v4l2_cap.c
@@ -668,6 +668,10 @@ static void convert_to_imgdatafmt(FAR video_format_t *video,
         data->pixelformat = IMGDATA_PIX_FMT_ENTROPY;
         break;
 
+      case V4L2_PIX_FMT_SBGGR10P:
+        data->pixelformat = IMGDATA_PIX_FMT_SBGGR10P;
+        break;
+
       default: /* V4L2_PIX_FMT_JPEG_WITH_SUBIMG */
         data->pixelformat = IMGDATA_PIX_FMT_JPEG_WITH_SUBIMG;
         break;
@@ -715,6 +719,10 @@ static void convert_to_imgsensorfmt(FAR video_format_t *video,
         sensor->pixelformat = IMGSENSOR_PIX_FMT_ENTROPY;
         break;
 
+      case V4L2_PIX_FMT_SBGGR10P:
+        sensor->pixelformat = IMGSENSOR_PIX_FMT_SBGGR10P;
+        break;
+
       default: /* V4L2_PIX_FMT_JPEG_WITH_SUBIMG */
         sensor->pixelformat = IMGSENSOR_PIX_FMT_JPEG_WITH_SUBIMG;
         break;
@@ -1363,6 +1371,8 @@ static size_t get_bufsize(FAR video_format_t *vf)
       case V4L2_PIX_FMT_RGB565X:
       default:
         return ret * 2;
+      case V4L2_PIX_FMT_SBGGR10P:
+        return ret * 5 / 4;
       case V4L2_PIX_FMT_JPEG:
       case V4L2_PIX_FMT_ENTROPY:
         return ret;
@@ -2631,6 +2641,7 @@ static int capture_try_fmt(FAR struct file *filep,
       case V4L2_PIX_FMT_RGB565X:
       case V4L2_PIX_FMT_JPEG:
       case V4L2_PIX_FMT_ENTROPY:
+      case V4L2_PIX_FMT_SBGGR10P:
       case V4L2_PIX_FMT_JPEG_WITH_SUBIMG:
         nr_fmt = 1;
         vf[CAPTURE_FMT_MAIN].width       = fmt->fmt.pix.width;
