+      return -ENODEV;
+    }
+
+  ret = cap_register("/dev/capture2", cap);
+  if (ret < 0)
+    {
+      syslog(LOG_ERR, "ERROR: cap_register failed: %d\n", ret);
+      return ret;
+    }
+#endif
+
+  return OK;
+}
+#endif
diff --git a/boards/risc-v/esp32p4/common/src/esp_board_pcnt.c b/boards/risc-v/esp32p4/common/src/esp_board_pcnt.c
